<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheet/style.css" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div class="main p-14 w-full min-h-screen bg-zinc-900">
      <div class="form p-10 text-white">
          <form action="/create" method="post">
            <input
              class="block px-5 py-2 bg-zinc-500 w-full rounded-md outline-none"
              type="text"
              placeholder="title goes here"
              name="title"
            />

            <textarea
              class="block px-5 py-2 bg-zinc-500 resize-none mt-2 w-fullrounded-md outline-none"
              placeholder="write your details of task"
              name="details"
            ></textarea>

            <input
              class="mt-2 bg-blue-500 px-5 py-2 rounded-lg"
              type="submit"
              value="create task"
            />
          </form>
      </div>
      
      <div class="task p-14 flex gap-3 flex-wrap">
        <% if(files.length > 0){ %>
            <% files.forEach((val)=>{ %>
              <div class="task  w-72 px-4 py-4 rounded-md bg-zinc-800">
                <h1 class="text-white text-2xl"><%= val %></h1>
                <div class="flex w-full justify-between items-center">
                  <a class="text-blue-500 inline-block mt-3" href="/files/<%= val %>">Read More</a>
                  <a class="text-zinc-600" href="/edit/<%= val %>">edit</a>
                </div>              
        
              </div>
            <% }) %>
        <% } else { %>
          <h2 class="text-zinc-600">No Tasks Yet</h2>
        <% } %>
            
      </div>
    </div>
  </body>
</html>
