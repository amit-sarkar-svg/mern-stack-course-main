<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheet/style.css" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div class="main p-14 w-full min-h-screen bg-zinc-900 text-white">
      <a class="text-blue-500 inline-block mb-7" href="/">Go To Home</a>
      <form action="/edit" method="post">
            <input
              class="block px-5 py-2 bg-zinc-700 w-1/4 rounded-md outline-none"
              type="text"
              placeholder="previous name"
              name="previous"
              value="<%= filename %>"
            />
            <input
              class="block px-5 py-2 bg-zinc-700 w-1/4 rounded-md outline-none mt-2"
              type="text"
              placeholder="New name"
              name="new"

            />
            <input
              class="mt-2 bg-yellow-500 px-5 py-2 rounded-lg"
              type="submit"
              value="update name"
            />
          </form>
    </div>
  </body>
</html>
