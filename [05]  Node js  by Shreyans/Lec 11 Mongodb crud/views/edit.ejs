<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <div class="w-full h-full bg-zinc-900 p-10 text-white">
      <div class="nav mb-10">
        <a class="text-blue-500" href="/read"> Read Users </a>
      </div>
      <h1 class="text-3xl mb-3">Edit User</h1>
      <form class="" action="/update/<%= user._id %>" method="post">
        <input
          class="px-5 py-2 border-2 bg-zinc-800 outline-none rounded-lg bg-transparent"
          type="text"
          placeholder="name"
          name="name"
          value='<%= user.name %>'
        />
        <input
          class="px-5 py-2 border-2 bg-zinc-800 outline-none rounded-lg bg-transparent"
          type="text"
          placeholder="email"
          name="email"
          value='<%= user.email %>'
        />
        <input
          class="px-5 py-2 border-2 bg-zinc-800 outline-none rounded-lg bg-transparent"
          type="text"
          placeholder="image-url"
          name="image"
          value='<%= user.image %>'
        />
        <input
          class="px-5 py-2 bg-yellow-500 rounded-lg ml-3 text-black"
          type="submit"
          value="update"
        />
      </form>
    </div>
  </body>
</html>
