<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 p-10 text-white">
        <h2 class="text-3xl mb-3 " >Login your Account</h2>
        <form action="/login" method="post" class="m-auto flex flex-col w-1/4 gap-4">          
            <input class="px-3 py-2 outline-none rounded-md bg-transparent border-2 border-zinc-800" type="text" name="email" placeholder="email">
            <input class="px-3 py-2 outline-none rounded-md bg-transparent border-2 border-zinc-800" type="text" name="password" placeholder="password">
            <input class="px-4 py-3 bg-blue-500 rounded-md" type="submit" value="Login">

        </form>
    </div>
</body>
</html>