<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div class="w-full min-h-screen bg-zinc-900 p-10 text-white">
      <div class="w-full flex justify-end">
        <a
          class="bg-red-500 rounded-md px-3 py-2 text-sm mb-5 inline-block"
          href="/logout"
          >Logout</a
        >
      </div>
      <h5 class="text-xl mb-3">Edit Post</h5>
      <form action="/update/<%= post._id %>" method="post">
        <textarea
          name="content"
          placeholder="what's on your mind?"
          class="block p-3 w-1/3 bg-transparent bg-zinc-800 border-2 rounded-md border-none mb-2"
        >
<%= post.content %></textarea
        >
        <input
          class="px-2 w-40 py-3 bg-yellow-500 text-black rounded-md block"
          type="submit"
        />
      </form>
    </div>
  </body>
</html>
