<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 p-10 text-white">
        <div class="w-full flex justify-end">
            <a class="bg-red-500 rounded-md px-3 py-2 text-sm mb-5 inline-block" href="/logout">Logout</a>
        </div>

        <h2 class="text-3xl mb-3 "> Heloo, <%= user.name %> </h2>
        <form action="/post" method="post">
            <textarea name="content" placeholder="what's on your mind?" class="block p-3 w-1/3 bg-transparent bg-zinc-800 border-2 rounded-md border-none mb-2" ></textarea>
            <input class="px-2 w-40 py-3 bg-blue-500 rounded-md block" type="submit">
        </form>

        <div class="posts mt-20">
            <h3 class="text-zinc-400 text-2xl mb-3">Your Posts.</h3>
            <div class="postcontainer flex flex-col gap-5">

                <% user.posts.forEach(post => { %>
                    <div class="post w-1/3 p-5 border-2 border-zinc-800 ">
                        <h4 class="text-xl mb-2"><%= user.name %></h4>
                        <p class="text-zinc-400 tracking-tight"> <%= post.content %> </p>
                        <small class="mt-2 inline-block text-zinc-500"> <%= post.likes.length %> likes </small>

                        <div class="btns flex mt-5">
                            <a class="text-blue-500 pr-5 mb-3 border-1px" href="/like/<%= post._id %>"> <%= post.likes.indexOf(user._id) === -1 ? "Like" : "Unlike" %> </a>
                            <a class="text-zinc-400 mb-3 border-1px" href="/edit/<%= post._id %>">Edit</a>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        
    </div>
</body>
</html>